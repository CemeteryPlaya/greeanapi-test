# Скопируйте в .env.local, чтобы форма входа заполнялась автоматически (только для `npm run dev`).
# .env.local в .gitignore — токены не попадут в репозиторий и в production-сборку.
# На Vercel эти переменные НЕ задавайте.

# Мессенджер, выбранный по умолчанию: whatsapp | telegram
VITE_GREEN_API_PLATFORM=whatsapp

# Инстанс WhatsApp
VITE_GREEN_API_WHATSAPP_URL=
VITE_GREEN_API_WHATSAPP_ID_INSTANCE=
VITE_GREEN_API_WHATSAPP_TOKEN=

# Инстанс Telegram
VITE_GREEN_API_TELEGRAM_URL=
VITE_GREEN_API_TELEGRAM_ID_INSTANCE=
VITE_GREEN_API_TELEGRAM_TOKEN=
